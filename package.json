{
  "name": "oh-my-agent-ide",
  "version": "0.8.0",
  "description": "Desktop IDE where a Dispatcher hands work to Worker agents and you see only decisions and results",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p .",
    "lint": "node scripts/lint.mjs",
    "test": "esbuild \"test/*.test.ts\" --bundle --platform=node --format=esm --outdir=dist/test --out-extension:.js=.mjs --alias:electron=./test/stubs/electron.ts --external:@anthropic-ai/claude-agent-sdk --external:zod --log-level=warning && node --test \"dist/test/*.test.mjs\"",
    "start": "node build.mjs && electron .",
    "dev": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --publish never",
    "dist:win": "node build.mjs && electron-builder --win --publish never",
    "dist:mac": "node build.mjs && electron-builder --mac --publish never",
    "release": "node scripts/release.mjs",
    "e2e": "node build.mjs && node test/e2e/shard.mjs 1/1",
    "e2e:visual": "node build.mjs && node --test test/e2e/visual.e2e.mjs",
    "e2e:visual:update": "node build.mjs && node --test --test-update-snapshots test/e2e/visual.e2e.mjs",
    "icon": "node scripts/make-icon.mjs && electron scripts/render-icon.cjs",
    "postinstall": "node scripts/pty-helper.mjs"
  },
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.329",
    "electron-updater": "^6.8.11",
    "node-pty": "1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "productName": "Oh My Agent IDE",
  "private": true,
  "build": {
    "appId": "dev.ohmyagent.ide",
    "publish": [
      {
        "provider": "github",
        "owner": "wool0826",
        "repo": "oh-my-agent-ide"
      }
    ],
    "productName": "Oh My Agent IDE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "!node_modules/node-pty/{src,deps,third_party,scripts,typings}/**",
      "!node_modules/node-pty/**/*.pdb",
      "!node_modules/node-pty/binding.gyp"
    ],
    "extraResources": [
      {
        "from": "resources/plugin",
        "to": "plugin"
      },
      {
        "from": "build/icon.png",
        "to": "tray.png"
      },
      {
        "from": "build/icon.ico",
        "to": "app.ico"
      }
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "node_modules/node-pty/**",
      "dist/ptyHost.cjs"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "OhMyAgentIDE-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "OhMyAgentIDE-${version}-${arch}.${ext}",
      "icon": "build/icon.icns"
    }
  },
  "overrides": {
    "minimatch@^9.0.0": "^11.0.9",
    "minimatch@^10.0.0": "^11.0.9"
  }
}
